# Copy to .dev.vars — Cloudflare Pages Functions read this file, not .env.local.
# `next dev` uses GROQ_API_KEY from .env.local instead.
#
# Get a free key at https://console.groq.com/keys
#
# In production, set GROQ_API_KEY as a secret in the Cloudflare Pages
# project's dashboard (Settings > Environment variables), not in this file.
GROQ_API_KEY=

# Optional — defaults to openai/gpt-oss-120b if unset.
GROQ_MODEL=
