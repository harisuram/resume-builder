# Copy to .env.local for local development, or set these in your Cloudflare
# Pages project's environment variables before building for production.
# Everything here is optional — the app works fully without any of it.

# Your real domain, used for canonical URLs, Open Graph tags, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google AdSense. Leave unset to ship with ads fully disabled (no script
# loaded, no ad slots rendered, empty ads.txt) — useful for local dev/preview
# builds. Set NEXT_PUBLIC_ADSENSE_CLIENT_ID to turn ads on everywhere at once.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_BUILDER=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_NAV=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_EXPORT=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_SECTION_FOOTER=0000000000

# The "Make ATS-friendly" AI button (functions/api/optimize.ts) is NOT
# configured via this file — it's a Cloudflare Pages Function, which uses
# Cloudflare's own secrets mechanism instead of Next.js env vars.
# See .dev.vars.example for local dev, or set GROQ_API_KEY as a secret in
# the Cloudflare Pages dashboard for production.
