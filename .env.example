# Copy to .env.local for local development, or set these as **build**
# environment variables in the Cloudflare Worker before building.
# NEXT_PUBLIC_* values are baked into the static HTML at `next build`.
# Everything here is optional — the app works fully without any of it.

# Your real domain, used for canonical URLs, Open Graph tags, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google AdSense. The publisher id already defaults to this site's account
# in lib/ads.ts (the snippet Google issued). Set it to empty or
# ca-pub-0000000000000000 to disable the loader, ads.txt, and meta tag.
# Slot ids: create ad units in AdSense and paste them here. Leave the zeros
# to keep in-page AdSlots collapsed (Auto ads can still run from the script).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-9224755974440077
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_BUILDER=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_BUILDER_TOP=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_NAV=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_EXPORT=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_SECTION_FOOTER=0000000000

# The "Make ATS-friendly" button and resume import both use GROQ_API_KEY.
# Local `next dev` reads it from this file (never NEXT_PUBLIC_ — the key must
# stay on the server). Production uses a Cloudflare Worker secret of the same
# name; see .dev.vars.example.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=
