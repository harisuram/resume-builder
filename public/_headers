/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=600

# Share card image — `/og.png` is published by scripts/build.mjs (copy of the
# Next-generated opengraph-image). Messengers need the .png suffix.
/og.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400

# Next still emits the extensionless file; keep MIME so old scrapers work.
/opengraph-image
  Content-Type: image/png

/apple-icon
  Content-Type: image/png

/icon
  Content-Type: image/png

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
